{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  // github-actions / cargo / devcontainers are handled by Dependabot
  // (.github/dependabot.yml); Renovate only tracks the container images
  // referenced from workflow files
  enabledManagers: ['custom.regex'],
  customManagers: [
    {
      customType: 'regex',
      description: 'Runner container images declared in workflow matrix entries',
      managerFilePatterns: ['/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/'],
      matchStrings: [
        'container:\\s*(?<depName>[a-zA-Z0-9][a-zA-Z0-9._/-]*):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      // tags follow `wasi-sdk-<N>`; map the trailing number to the major
      // version so tag bumps (e.g. wasi-sdk-29 -> wasi-sdk-30) are detected
      matchPackageNames: ['ghcr.io/portable-network-archive/wasi-sdk-gh-actions'],
      versioning: 'regex:^(?:wasi-sdk-)?(?<major>\\d+)$',
    },
  ],
}
